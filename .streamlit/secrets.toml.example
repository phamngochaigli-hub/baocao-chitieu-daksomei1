# Sao chép file này thành .streamlit/secrets.toml (KHÔNG đưa file thật lên GitHub).
# Trên Streamlit Cloud: dán nội dung vào App settings -> Secrets.

# Mật khẩu vào app (bỏ trống/xoá dòng này nếu không cần đăng nhập)
APP_PASSWORD = "doi-mat-khau-nay"

# ID thư mục Drive để lưu (lấy từ URL: drive.google.com/drive/folders/<ID>).
# Nếu bỏ trống, app tự tạo thư mục DRIVE_FOLDER_NAME ở thư mục gốc My Drive.
DRIVE_FOLDER_ID = ""
DRIVE_FOLDER_NAME = "LuuTruVanBan"

# Cho phép xoá văn bản (chuyển vào thùng rác Drive)
ALLOW_DELETE = false

# Cách 1 (khuyên dùng với tài khoản Gmail cá nhân): chạy get_refresh_token.py để lấy
[google_oauth]
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "xxxx"
refresh_token = "xxxx"

# Cách 2: Service account — CHỈ dùng được với Shared Drive (Google Workspace),
# vì service account không có dung lượng lưu trữ riêng. Khi dùng cách này,
# xoá mục [google_oauth] ở trên, đặt DRIVE_FOLDER_ID là ID thư mục trong Shared Drive
# và thêm email service account làm thành viên của Shared Drive.
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
