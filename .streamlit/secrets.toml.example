# Sao chép thành .streamlit/secrets.toml (KHÔNG đưa tệp đó lên GitHub),
# hoặc dán nội dung vào mục "Secrets" của Streamlit Community Cloud.

ten_co_quan = "UBND xã Đăk Sơmei"
so_ngay_bao_truoc = 3          # cảnh báo "sắp đến hạn" khi còn <= N ngày

# Khóa API Claude (https://console.anthropic.com). Bỏ trống → dùng quy tắc đơn giản.
ANTHROPIC_API_KEY = "sk-ant-..."

[google_drive]
# ID thư mục: phần cuối của đường dẫn https://drive.google.com/drive/folders/<ID>
folder_id = "1AbCdEf..."

# Cách 1 — Tài khoản dịch vụ (khuyến nghị, thư mục phải nằm trong Bộ nhớ dùng chung / Shared Drive).
# Dán các trường của tệp JSON khóa tài khoản dịch vụ:
[google_drive.credentials]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "ten-tai-khoan@du-an.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"

# Cách 2 — OAuth của người dùng (dùng cho "Drive của tôi" trên tài khoản Gmail cá nhân).
# Xóa bảng [google_drive.credentials] ở trên và thay bằng:
# [google_drive.credentials]
# type = "authorized_user"
# client_id = "..."
# client_secret = "..."
# refresh_token = "..."

# Tài khoản người dùng. Mật khẩu lưu dạng SHA-256:
#   python -c "import hashlib;print(hashlib.sha256('mat-khau'.encode()).hexdigest())"
# vai_tro: quan_tri | chuyen_vien | can_bo_duyet | don_vi
[nguoi_dung.quantri]
ho_ten = "Nguyễn Văn A"
vai_tro = "quan_tri"
mat_khau_sha256 = "..."

[nguoi_dung.chuyenvien]
ho_ten = "Trần Thị B"
vai_tro = "chuyen_vien"
mat_khau_sha256 = "..."

[nguoi_dung.lanhdao]
ho_ten = "Lê Văn C"
vai_tro = "can_bo_duyet"
mat_khau_sha256 = "..."

[nguoi_dung.phongkinhte]
ho_ten = "Phòng Kinh tế"
vai_tro = "don_vi"
don_vi = "Phòng Kinh tế"   # phải trùng tên trong danh mục đơn vị
mat_khau_sha256 = "..."
